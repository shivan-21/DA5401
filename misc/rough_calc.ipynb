   "outputs": [],
   "source": [
    "import math\n",
    "ls = [0,0.8,0.65,0.2,-0.5, - 0.3]\n",
    "\n",
    "mean, sum, var = 0.0, 0.0, 0.0\n",
    "\n",
    "for i in ls:\n",
    "  sum += i\n",
    "\n",
    "mean = sum/len(ls)\n",
    "\n",
    "for i in ls:\n",
    "  var += (i - mean)**2\n",
    "\n",
    "var = var/len(ls)\n",
    "std = math.sqrt(var)"
   ]
  },
